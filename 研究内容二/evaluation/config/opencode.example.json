{
  "model": "provider/model-name",
  "provider": {
    "provider": {
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "model-name": {
          "name": "model-name",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      },
      "options": {
        "baseURL": "{env:MODEL_BASE_URL}",
        "apiKey": "{env:MODEL_API_KEY}"
      }
    }
  }
}
