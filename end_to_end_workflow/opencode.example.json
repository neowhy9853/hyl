{
  "$schema": "https://opencode.ai/config.json",
  "model": "service/your-model",
  "provider": {
    "service": {
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "your-model": {
          "id": "your-model",
          "limit": {"context": 65536, "output": 8192}
        }
      },
      "options": {
        "baseURL": "{env:MODEL_BASE_URL}",
        "apiKey": "{env:MODEL_API_KEY}"
      }
    }
  }
}
