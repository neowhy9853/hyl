    "prefer_artifacts": [
      "analysis-context.json",
      "analysis.json",
      "patch.diff"
    ],
    "avoid_until_needed": [
      "candidates.json",
      "report.md",
      "effective-profile.yaml",
      "unchanged source files outside candidate_hunks[].file"
    ]
  }
}
