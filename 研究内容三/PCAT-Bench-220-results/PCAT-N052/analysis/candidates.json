        "snippet": "      - 'tests/imhttp-metrics.sh'\n      - 'tests/stats-prometheus-escaping.sh'\n      - 'devtools/test-imhttp-prometheus-scrape.sh'\n      - '.github/workflows/imhttp_prometheus_scrape.yml'\n\npermissions:\n  contents: read\n\nconcurrency:\n  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}\n  cancel-in-progress: true\n\njobs:\n  scrape:\n    runs-on: ubuntu-latest\n    timeout-minutes: 25\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0\n        with:\n          persist-credentials: false\n\n      - name: Build imhttp test target\n        env:\n          RSYSLOG_DEV_CONTAINER: rsyslog/rsyslog_dev_base_ubuntu:26.04\n        run: |\n          chmod -R go+rw .\n          devtools/devcontainer.sh --rm bash -lc '\n            ./autogen.sh --enable-testbench --enable-imdiag --enable-omstdout --enable-impstats --enable-imhttp &&\n            make -j10'\n\n      - name: Scrape the rsyslog container with Prometheus\n        run: devtools/test-imhttp-prometheus-scrape.sh\n"
