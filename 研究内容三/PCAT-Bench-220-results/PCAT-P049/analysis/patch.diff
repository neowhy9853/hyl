From fc49936904594ff82100e727242fabe968fbd6c8 Mon Sep 17 00:00:00 2001
From: Beniamino Galvani <bgalvani@redhat.com>
Date: Fri, 3 Jul 2026 19:30:48 +0200
Subject: [PATCH] version: add 1.60 macros

---
 src/libnm-core-public/nm-version-macros.h.in |  1 +
 src/libnm-core-public/nm-version.h           | 14 ++++++++++++++
 2 files changed, 15 insertions(+)

diff --git a/src/libnm-core-public/nm-version-macros.h.in b/src/libnm-core-public/nm-version-macros.h.in
index c1e0ba540c..4795aeb283 100644
--- a/src/libnm-core-public/nm-version-macros.h.in
+++ b/src/libnm-core-public/nm-version-macros.h.in
@@ -80,6 +80,7 @@
 #define NM_VERSION_1_54   (NM_ENCODE_VERSION(1, 54, 0))
 #define NM_VERSION_1_56   (NM_ENCODE_VERSION(1, 56, 0))
 #define NM_VERSION_1_58   (NM_ENCODE_VERSION(1, 58, 0))
+#define NM_VERSION_1_60   (NM_ENCODE_VERSION(1, 60, 0))
 
 /* For releases, NM_API_VERSION is equal to NM_VERSION.
  *
diff --git a/src/libnm-core-public/nm-version.h b/src/libnm-core-public/nm-version.h
index f99851194b..ff037e6052 100644
--- a/src/libnm-core-public/nm-version.h
+++ b/src/libnm-core-public/nm-version.h
@@ -467,6 +467,20 @@
 #define NM_AVAILABLE_IN_1_58
 #endif
 
+#if NM_VERSION_MIN_REQUIRED >= NM_VERSION_1_60
+#define NM_DEPRECATED_IN_1_60        G_DEPRECATED
+#define NM_DEPRECATED_IN_1_60_FOR(f) G_DEPRECATED_FOR(f)
+#else
+#define NM_DEPRECATED_IN_1_60
+#define NM_DEPRECATED_IN_1_60_FOR(f)
+#endif
+
+#if NM_VERSION_MAX_ALLOWED < NM_VERSION_1_60
+#define NM_AVAILABLE_IN_1_60 G_UNAVAILABLE(1, 60)
+#else
+#define NM_AVAILABLE_IN_1_60
+#endif
+
 /*
  * Synchronous API for calling D-Bus in libnm is deprecated. See
  * https://networkmanager.dev/docs/libnm/latest/usage.html#sync-api
-- 
2.43.0

