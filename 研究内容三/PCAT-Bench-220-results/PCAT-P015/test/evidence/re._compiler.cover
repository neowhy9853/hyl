                           else:
  521:                         for i in r:
  508:                             charmap[i] = 1
    1:                 elif op is NEGATE:
    1:                     out.append((op, av))
                       elif op is CATEGORY and tail and (CATEGORY, CH_NEGATE[av]) in tail:
