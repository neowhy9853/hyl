       def _compile_charset(charset, flags, code):
           # compile charset subprogram
   15:     emit = code.append
   34:     for op, av in charset:
   19:         emit(op)
   19:         if op is NEGATE:
    1:             pass
   18:         elif op is LITERAL:
    6:             emit(av)
   12:         elif op is RANGE or op is RANGE_UNI_IGNORE:
    7:             emit(av[0])
    7:             emit(av[1])
    5:         elif op is CHARSET:
    5:             code.extend(av)
               elif op is BIGCHARSET:
                   code.extend(av)
               elif op is CATEGORY:
                   if flags & SRE_FLAG_LOCALE:
                       emit(CH_LOCALE[av])
                   elif flags & SRE_FLAG_UNICODE:
                       emit(CH_UNICODE[av])
                   else:
                       emit(av)
               else:
                   raise PatternError(f"internal: unsupported set operator {op!r}")
   15:     emit(FAILURE)
       
       def _optimize_charset(charset, iscased=None, fixup=None, fixes=None):
