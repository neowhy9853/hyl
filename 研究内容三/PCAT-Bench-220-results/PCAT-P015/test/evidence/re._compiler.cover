    6:                 emit((group-1)*2)
                   # _compile_info(code, p, _combine_flags(flags, add_flags, del_flags))
    6:             _compile(code, p, _combine_flags(flags, add_flags, del_flags))
    6:             if group:
    6:                 emit(MARK)
    6:                 emit((group-1)*2+1)
