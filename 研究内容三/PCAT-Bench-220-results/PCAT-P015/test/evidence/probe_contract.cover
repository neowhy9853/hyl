       #!/usr/bin/env python3
    1: """PCA-0001/PCA-0002 contract probe. Usage: <python> probe_contract.py <version> <output_dir>"""
    1: import os, sys, json, struct, tempfile, shutil
    1: import zipfile
    1: from zipfile import ZipInfo
       
    1: _MASK_UTF_FILENAME = 1 << 11
    1: VERSION = sys.argv[1] if len(sys.argv) > 1 else 'unknown'
    1: OUTDIR = sys.argv[2] if len(sys.argv) > 2 else '.'
    1: results = []
       
    1: def record(tid, cat, val, detail=''):
   19:     results.append({'test_id':tid,'version':VERSION,'category':cat,'value':str(val),'detail':detail})
       
    1: def mk_zi(name, fb=0):
   16:     zi = ZipInfo(name)
   16:     zi.flag_bits = fb; zi.compress_type = zipfile.ZIP_STORED
   16:     zi.CRC = 0; zi.compress_size = 0; zi.file_size = 0
   16:     zi.header_offset = 0; zi._end_offset = None
   16:     zi.internal_attr = 0; zi.external_attr = 0
   16:     zi.extra = b''; zi.comment = b''
   16:     zi.extract_version = 10; zi.create_version = 10
   16:     zi.create_system = 3; zi.reserved = 0; zi.volume = 0
   16:     return zi
       
    1: def ph(header):
   15:     fb = struct.unpack_from('<H', header, 6)[0]
   15:     return fb, header[30:30+struct.unpack_from('<H', header, 26)[0]].hex()
       
    1: def raw_cp437_zip(fbytes):
    1:     fname = fbytes.decode('cp437')
    1:     td = tempfile.mkdtemp(); zp = os.path.join(td, 'z.zip')
    1:     try:
    1:         with zipfile.ZipFile(zp, 'w') as zf: zf.writestr(fname, b'x')
    1:         with open(zp, 'rb') as f: d = bytearray(f.read())
    1:         lf = d[6]|(d[7]<<8); lf &= ~_MASK_UTF_FILENAME
    1:         d[6]=lf&0xFF; d[7]=(lf>>8)&0xFF
    1:         d[26]=len(fbytes)&0xFF; d[27]=(len(fbytes)>>8)&0xFF
    5:         for i,b in enumerate(fbytes): d[30+i]=b
    1:         cs = d.find(b'PK\x01\x02')
    1:         if cs>=0:
    1:             cf = d[cs+8]|(d[cs+9]<<8); cf &= ~_MASK_UTF_FILENAME
    1:             d[cs+8]=cf&0xFF; d[cs+9]=(cf>>8)&0xFF
    1:             d[cs+28]=len(fbytes)&0xFF; d[cs+29]=(len(fbytes)>>8)&0xFF
    5:             for i,b in enumerate(fbytes): d[cs+46+i]=b
    1:         return bytes(d)
           finally:
    1:         shutil.rmtree(td)
       
    1: def test_all():
           # FileHeader cp437 names, flag_bits=0
    5:     for tid,real in [('fuenf','fünf'),('cafe','café'),('resume','résumé'),('muenchen','München')]:
    4:         fb,fh = ph(mk_zi(real,0).FileHeader())
    4:         record(f'fh-cp437-{tid}','OUTPUT_FORMAT_CHANGE',f'flags={fb:#06x} bytes={fh}')
       
           # FileHeader cp437 names, flag_bits=UTF8
    5:     for tid,real in [('fuenf','fünf'),('cafe','café'),('resume','résumé'),('muenchen','München')]:
    4:         fb,fh = ph(mk_zi(real,_MASK_UTF_FILENAME).FileHeader())
    4:         record(f'fh-utf8flag-{tid}','OUTPUT_FORMAT_CHANGE',f'flags={fb:#06x} bytes={fh}')
       
           # ASCII names with UTF-8 flag
    4:     for n in ['hello.txt','simple','test_file.zip']:
    3:         fb,fh = ph(mk_zi(n,_MASK_UTF_FILENAME).FileHeader())
    3:         record(f'ascii-{n}','OUTPUT_FORMAT_CHANGE',f'flags={fb:#06x} bytes={fh}')
       
           # Unicode-only names, flag_bits=0
    5:     for tid,real in [('nihao','你好'),('japan','日本語'),('korea','한국어'),('sao','São Paulo')]:
    4:         fb,fh = ph(mk_zi(real,0).FileHeader())
    4:         record(f'unicode-{tid}','OUTPUT_FORMAT_CHANGE',f'flags={fb:#06x} bytes={fh}')
       
           # _encodeFilenameFlags flag clearing
    1:     _,rf = mk_zi('pure_ascii.txt',_MASK_UTF_FILENAME)._encodeFilenameFlags()
    1:     record('flagbits-clearing','OUTPUT_FORMAT_CHANGE',f'resulting_flags={rf:#06x}')
       
           # Append preservation
    1:     fbts = 'fünf'.encode('cp437')
    1:     raw = raw_cp437_zip(fbts)
    1:     td = tempfile.mkdtemp(); zp = os.path.join(td, 't.zip')
    1:     try:
    1:         with open(zp,'wb') as f: f.write(raw)
    1:         with zipfile.ZipFile(zp,'a') as zf: zf.writestr('n.txt','n')
    2:         with zipfile.ZipFile(zp,'r') as zf:
    3:             orig = [i for i in zf.infolist() if i.filename!='n.txt'][0]
    2:         record('append-preservation','SIDE_EFFECT_CHANGE',
    3:                f'orig_flag_bits={orig.flag_bits:#06x} names={[i.filename for i in zf.infolist()]}')
           finally:
    1:         shutil.rmtree(td)
       
           # New write flag_bits
    1:     td = tempfile.mkdtemp(); zp = os.path.join(td, 'n.zip')
    1:     try:
    2:         with zipfile.ZipFile(zp,'w') as zf:
    1:             zf.writestr('a.txt','x'); zf.writestr('b.txt','x')
    2:         with zipfile.ZipFile(zp,'r') as zf:
    3:             for i in zf.infolist():
    2:                 record(f'newwrite-{i.filename}','SIDE_EFFECT_CHANGE',f'flag_bits={i.flag_bits:#06x}')
           finally:
    1:         shutil.rmtree(td)
       
    1: if __name__=='__main__':
    1:     print(f'Probes for {VERSION}...')
    1:     test_all()
    1:     op = os.path.join(OUTDIR, f'probe_results_{VERSION}.json')
    1:     with open(op,'w') as f: json.dump({'version':VERSION,'total':len(results),'results':results},f,indent=2)
    1:     print(f'  {len(results)} results -> {op}')
