From 39b6be1fb28fdbf0dfa80996b0a737827b080cb7 Mon Sep 17 00:00:00 2001
From: Maximiliano Sandoval <msandova@gnome.org>
Date: Sun, 31 May 2026 10:29:51 +0200
Subject: [PATCH] Use canonical signal names

As per the docs of g_signal_new:

> When registering a signal and looking up a signal, either separator
> can be used, but they cannot be mixed. Using `-` is considerably more
> efficient. Using `_` is discouraged.
---
 examples/simple-proxy.c            | 2 +-
 libsoup/auth/soup-auth-negotiate.c | 2 +-
 tests/auth-test.c                  | 2 +-
 tests/multipart-test.c             | 2 +-
 tests/ntlm-test.c                  | 4 ++--
 tests/redirect-test.c              | 2 +-
 tests/server-auth-test.c           | 2 +-
 7 files changed, 8 insertions(+), 8 deletions(-)

diff --git a/examples/simple-proxy.c b/examples/simple-proxy.c
index f196d68f..63dae2c2 100644
--- a/examples/simple-proxy.c
+++ b/examples/simple-proxy.c
@@ -352,7 +352,7 @@ server_callback (SoupServer *server, SoupServerMessage *msg,
 	soup_message_headers_set_encoding (soup_server_message_get_response_headers (msg),
 					   SOUP_ENCODING_CHUNKED);
 
-	g_signal_connect (client_msg, "got_headers", G_CALLBACK (send_headers), msg);
+	g_signal_connect (client_msg, "got-headers", G_CALLBACK (send_headers), msg);
 
         GCancellable *client_cancellable = g_cancellable_new ();
 	g_signal_connect (msg, "finished", G_CALLBACK (client_msg_failed), client_cancellable);
diff --git a/libsoup/auth/soup-auth-negotiate.c b/libsoup/auth/soup-auth-negotiate.c
index b78bde54..16b3014d 100644
--- a/libsoup/auth/soup-auth-negotiate.c
+++ b/libsoup/auth/soup-auth-negotiate.c
@@ -267,7 +267,7 @@ soup_auth_negotiate_update_connection (SoupConnectionAuth *auth, SoupMessage *ms
 			if (!g_object_get_data (G_OBJECT (msg), "negotiate-got-headers-connected")) {
 				/* Wait for the 2xx response to verify server response */
 				g_signal_connect_data (msg,
-						       "got_headers",
+						       "got-headers",
 						       G_CALLBACK (check_server_response),
 						       g_object_ref (auth),
 						       (GClosureNotify) g_object_unref,
diff --git a/tests/auth-test.c b/tests/auth-test.c
index f1c8d09d..674c62a0 100644
--- a/tests/auth-test.c
+++ b/tests/auth-test.c
@@ -313,7 +313,7 @@ do_pipelined_auth_test (void)
 		g_object_set_data (G_OBJECT (msg), "#", GINT_TO_POINTER (i + 1));
 		g_signal_connect (msg, "authenticate",
 				  G_CALLBACK (bug271540_authenticate), &authenticated);
-		g_signal_connect (msg, "wrote_headers",
+		g_signal_connect (msg, "wrote-headers",
 				  G_CALLBACK (bug271540_sent), &authenticated);
 
 		g_signal_connect (msg, "finished",
diff --git a/tests/multipart-test.c b/tests/multipart-test.c
index 7f53898f..3d85e22d 100644
--- a/tests/multipart-test.c
+++ b/tests/multipart-test.c
@@ -433,7 +433,7 @@ test_multipart (gconstpointer data)
 	soup_message_headers_append (soup_message_get_request_headers (msg),
 				     "Connection", "close");
 
-	g_signal_connect (msg, "got_headers",
+	g_signal_connect (msg, "got-headers",
 			  G_CALLBACK (got_headers), &headers_count);
 
 	g_signal_connect (msg, "content-sniffed",
diff --git a/tests/ntlm-test.c b/tests/ntlm-test.c
index 4670532a..fddad410 100644
--- a/tests/ntlm-test.c
+++ b/tests/ntlm-test.c
@@ -341,9 +341,9 @@ do_message (SoupSession *session,
 				  G_CALLBACK (authenticate),
 				  (gpointer)user);
 	}
-	g_signal_connect (msg, "got_headers",
+	g_signal_connect (msg, "got-headers",
 			  G_CALLBACK (prompt_check), &state);
-	g_signal_connect (msg, "got_headers",
+	g_signal_connect (msg, "got-headers",
 			  G_CALLBACK (challenge_check), &state);
 	g_signal_connect (msg, "wrote-headers",
 			  G_CALLBACK (request_check), &state);
diff --git a/tests/redirect-test.c b/tests/redirect-test.c
index 45456d5b..c44b4e8a 100644
--- a/tests/redirect-test.c
+++ b/tests/redirect-test.c
@@ -186,7 +186,7 @@ do_message_api_test (SoupSession *session, TestCase *test)
 	}
 
 	treq = &test->requests[0];
-	g_signal_connect (msg, "got_headers",
+	g_signal_connect (msg, "got-headers",
 			  G_CALLBACK (got_headers), &treq);
 	g_signal_connect (msg, "restarted",
 			  G_CALLBACK (restarted), &treq);
diff --git a/tests/server-auth-test.c b/tests/server-auth-test.c
index 6605314e..c804ef75 100644
--- a/tests/server-auth-test.c
+++ b/tests/server-auth-test.c
@@ -337,7 +337,7 @@ main (int argc, char **argv)
 	test_init (argc, argv, no_test_entry);
 
 	server = soup_test_server_new (SOUP_TEST_SERVER_DEFAULT);
-	g_signal_connect (server, "request_started",
+	g_signal_connect (server, "request-started",
 			  G_CALLBACK (request_started_callback), NULL);
 	soup_server_add_handler (server, NULL,
 				 server_callback, NULL, NULL);
-- 
2.43.0

