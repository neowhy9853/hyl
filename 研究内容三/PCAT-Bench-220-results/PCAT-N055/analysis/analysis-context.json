          {
            "line": 14,
            "text": ""
          },
          {
            "line": 15,
            "text": ". lib/inittest --skip-with-lvmpolld --skip-with-lvmlockd"
          },
          {
            "line": 16,
            "text": ""
          },
          {
            "line": 17,
            "text": "# This test requires udev synchronization and SysV semaphore support"
          },
          {
            "line": 18,
            "text": "test \"$DM_UDEV_SYNCHRONIZATION\" -eq 1 || skip \"Needs udev synchronization\""
          },
          {
            "line": 19,
            "text": "test -e /proc/sysvipc/sem || skip \"No SysV semaphore support\""
          },
          {
            "line": 20,
            "text": "test -w /proc/sys/kernel/sem || skip \"Cannot modify semaphore limits\""
          },
          {
            "line": 21,
            "text": ""
          },
          {
            "line": 22,
            "text": "aux prepare_vg 1"
          },
          {
            "line": 23,
            "text": ""
          },
          {
            "line": 24,
            "text": "# Save original semaphore limits"
          },
          {
            "line": 25,
            "text": "ORIG_SEM=$(cat /proc/sys/kernel/sem)"
          },
          {
            "line": 26,
            "text": "read -r SEMMSL SEMMNS SEMOPM SEMMNI <<< \"$ORIG_SEM\""
          },
          {
            "line": 27,
            "text": ""
          },
          {
            "line": 28,
            "text": "# Restore semaphore limits on any exit path - the test framework"
          },
          {
            "line": 29,
            "text": "# teardown needs semaphores for udev transactions during cleanup."
          },
          {
            "line": 30,
            "text": "cleanup_and_teardown() {"
          },
          {
            "line": 31,
            "text": "\techo \"$ORIG_SEM\" > /proc/sys/kernel/sem"
          },
          {
            "line": 32,
            "text": "\ttest -n \"${HELD_SEM-}\" && ipcrm -s \"$HELD_SEM\" 2>/dev/null"
          },
          {
            "line": 33,
            "text": "\tHELD_SEM=\"\""
          },
          {
            "line": 34,
            "text": "\taux teardown"
          },
          {
            "line": 35,
            "text": "}"
          },
          {
            "line": 36,
            "text": "trap cleanup_and_teardown EXIT"
          },
          {
            "line": 37,
            "text": ""
          },
          {
            "line": 38,
            "text": "restore_sem_() {"
          },
          {
            "line": 39,
            "text": "\techo \"$ORIG_SEM\" > /proc/sys/kernel/sem"
          },
          {
            "line": 40,
            "text": "\ttest -n \"${HELD_SEM-}\" && ipcrm -s \"$HELD_SEM\" 2>/dev/null"
          },
          {
            "line": 41,
            "text": "\tHELD_SEM=\"\""
          },
          {
            "line": 42,
            "text": "}"
          },
          {
            "line": 43,
            "text": ""
          },
          {
            "line": 44,
            "text": "# Block new semaphore creation: hold one set, then lower SEMMNI"
          },
          {
            "line": 45,
            "text": "# to current usage so no new sets can be allocated."
          },
          {
            "line": 46,
            "text": "exhaust_sem_() {"
          },
          {
            "line": 47,
            "text": "\tHELD_SEM=$(ipcmk -S 1 | awk '{print $NF}')"
          },
          {
            "line": 48,
            "text": "\tCURRENT=$(( $(wc -l < /proc/sysvipc/sem) - 1 ))"
          },
          {
            "line": 49,
            "text": "\techo \"$SEMMSL $SEMMNS $SEMOPM $CURRENT\" > /proc/sys/kernel/sem"
          },
          {
            "line": 50,
            "text": "}"
          },
