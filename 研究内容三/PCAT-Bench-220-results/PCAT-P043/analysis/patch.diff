From 12cf5c3ad1474ec61ff068b2faae68beb3196405 Mon Sep 17 00:00:00 2001
From: Philip Withnall <pwithnall@gnome.org>
Date: Thu, 25 Jun 2026 18:02:00 +0100
Subject: [PATCH] gquark: Fix an incorrect G_GNUC_CONST annotation on
 g_quark_to_string()
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

It’s actually `G_GNUC_PURE` as its return value depends on the global
quark table.

Signed-off-by: Philip Withnall <pwithnall@gnome.org>
---
 glib/gquark.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/glib/gquark.h b/glib/gquark.h
index d0c44039f..8df350385 100644
--- a/glib/gquark.h
+++ b/glib/gquark.h
@@ -46,7 +46,7 @@ GQuark                g_quark_from_static_string (const gchar *string);
 GLIB_AVAILABLE_IN_ALL
 GQuark                g_quark_from_string        (const gchar *string);
 GLIB_AVAILABLE_IN_ALL
-const gchar *         g_quark_to_string          (GQuark       quark) G_GNUC_CONST;
+const gchar *         g_quark_to_string          (GQuark       quark) G_GNUC_PURE;
 
 #define G_DEFINE_QUARK(QN, q_n)                                         \
 GQuark                                                                  \
-- 
2.43.0

