        "assert not [s for s in d[\"segments\"] if s[\"id\"] < newest[\"first_live_segment\"]]",
        "' \"$state_file\" 2>/dev/null; then",
        "\t\t\treturn 0",
        "\t\tfi",
        "\t\t$TESTTOOL_DIR/msleep 100",
        "\tdone",
        "\techo \"FAIL: segmentedDisk pending deletion did not clear after recovery\"",
