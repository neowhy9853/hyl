        "startup",
        "if [ \"$SEGDISK_FAULT_POINT\" = segment-unlinked ]; then",
        "\t# The crash occurs after unlink but before pending-delete state can be",
        "\t# cleared. Output can become visible before the worker completes its batch,",
        "\t# so poll the exact durable state/file invariant rather than sampling the",
        "\t# legitimate in-progress transaction. The 30-second retry window bounds a real",
        "\t# cleanup failure while tolerating loaded CI runners. This runs before clean",
        "\t# shutdown so spool removal cannot hide a missed cleanup retry.",
        "\twait_seq_check 0 $((NUMMESSAGES - 1)) -d",
        "\twait_pending_delete_cleared || error_exit 1"
