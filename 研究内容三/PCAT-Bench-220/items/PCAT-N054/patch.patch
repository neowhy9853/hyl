 # A memory-tier-only enqueue during the grace period must wake the child and
 # restart the full timeout even though it does not itself spill to disk.
-./msleep 250
+./msleep 1000
 injectmsg 2000 1
 wait_file_lines "$RSYSLOG_OUT_LOG" 2001 300
-./msleep 300
+./msleep 2250
