 libsoup/soup-auth-manager-ntlm.c | 47 ++++++++++-------
 libsoup/soup-auth-manager.c      | 55 ++++++++++++++++----
 libsoup/soup-logger.c            | 46 ++++++++++-------
 libsoup/soup-session.c           | 87 +++++++++++++++++++++++++++++++-
 tests/auth-test.c                | 51 +++++++++++++++++++
 6 files changed, 253 insertions(+), 48 deletions(-)

