diff --git a/tests/auth-test.c b/tests/auth-test.c
index 6b5d6a2f..523cdef8 100644
--- a/tests/auth-test.c
+++ b/tests/auth-test.c
@@ -397,6 +397,24 @@ async_finished (SoupSession *session, SoupMessage *msg, gpointer user_data)
 		g_main_loop_quit (loop);
