From 204a6ddfb3bb456929e7c364e1e8d6ee1928b471 Mon Sep 17 00:00:00 2001
From: Patrick Colp <patrick.colp@oracle.com>
Date: Thu, 3 Apr 2025 14:04:11 -0700
Subject: [PATCH] loader/i386/linux: Update linux_kernel_params to match
 upstream

Update linux_kernel_params to match the v6.13.7 upstream version of boot_params.
Refactor most things out into structs, as the Linux kernel does.

edid_info should be a struct with "unsigned char dummy[128]" and efi_info should
be a struct as well, starting at 0x1c0. However, for backwards compatibility,
GRUB can have efi_systab at 0x1b8 and padding at 0x1bc (or padding at both spots).
This cuts into the end of edid_info. Make edid_info inline and only make it go
up to 0x1b8.

Signed-off-by: Patrick Colp <patrick.colp@oracle.com>
Reviewed-by: Daniel Kiper <daniel.kiper@oracle.com>
---
 grub-core/loader/i386/linux.c | 220 +++++++--------
 include/grub/i386/linux.h     | 506 ++++++++++++++++++++++------------
 2 files changed, 443 insertions(+), 283 deletions(-)

diff --git a/grub-core/loader/i386/linux.c b/grub-core/loader/i386/linux.c
index 4b26cd816..12731feb2 100644
--- a/grub-core/loader/i386/linux.c
+++ b/grub-core/loader/i386/linux.c
@@ -124,7 +124,7 @@ find_mmap_size (void)
 
   grub_mmap_iterate (count_hook, &count);
 
-  mmap_size = count * sizeof (struct grub_e820_mmap);
+  mmap_size = count * sizeof (struct grub_boot_e820_entry);
 
   /* Increase the size a bit for safety, because GRUB allocates more on
      later.  */
@@ -212,20 +212,20 @@ allocate_pages (grub_size_t prot_size, grub_size_t *align,
 }
 
