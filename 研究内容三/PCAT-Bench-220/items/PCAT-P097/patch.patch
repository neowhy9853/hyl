 src/vendor/golang.org/x/net/http/httpproxy/proxy.go | 13 +++++++------
 src/vendor/golang.org/x/net/quic/config.go          |  3 +++
 src/vendor/golang.org/x/net/quic/endpoint.go        |  9 ++++-----
 src/vendor/modules.txt                              |  2 +-
 8 files changed, 28 insertions(+), 17 deletions(-)
