diff --git a/src/net/http/transport.go b/src/net/http/transport.go
index 695f89b8cd..ef76d0852d 100644
--- a/src/net/http/transport.go
+++ b/src/net/http/transport.go
@@ -43,7 +43,8 @@ import (
 // used by [DefaultClient]. It establishes network connections as needed
 // and caches them for reuse by subsequent calls. It uses HTTP proxies
 // as directed by the environment variables HTTP_PROXY, HTTPS_PROXY
-// and NO_PROXY (or the lowercase versions thereof).
+// and NO_PROXY (or the lowercase versions thereof, which take
+// precedence over the uppercase versions).
 var DefaultTransport RoundTripper = &Transport{
 	Proxy: ProxyFromEnvironment,
 	DialContext: defaultTransportDialContext(&net.Dialer{
@@ -503,7 +504,8 @@ func (t *Transport) protocols() Protocols {
 // ProxyFromEnvironment returns the URL of the proxy to use for a
 // given request, as indicated by the environment variables
 // HTTP_PROXY, HTTPS_PROXY and NO_PROXY (or the lowercase versions
-// thereof). Requests use the proxy from the environment variable
+// thereof, which take precedence over the uppercase versions).
+// Requests use the proxy from the environment variable
 // matching their scheme, unless excluded by NO_PROXY.
 //
 // The environment values may be either a complete URL or a
diff --git a/src/vendor/golang.org/x/net/http/httpproxy/proxy.go b/src/vendor/golang.org/x/net/http/httpproxy/proxy.go
index 5ab499b0bc..1e260f4444 100644
--- a/src/vendor/golang.org/x/net/http/httpproxy/proxy.go
+++ b/src/vendor/golang.org/x/net/http/httpproxy/proxy.go
@@ -80,18 +80,19 @@ type config struct {
 	domainMatchers []matcher
 }
 
-// FromEnvironment returns a Config instance populated from the
-// environment variables HTTP_PROXY, HTTPS_PROXY and NO_PROXY (or the
-// lowercase versions thereof).
+// FromEnvironment returns a Config instance populated from the environment
+// variables HTTP_PROXY, HTTPS_PROXY and NO_PROXY (or the lowercase versions
+// thereof). When both the uppercase and lowercase versions are provided, the
+// lowercase versions are prioritized.
 //
 // The environment values may be either a complete URL or a
 // "host[:port]", in which case the "http" scheme is assumed. An error
 // is returned if the value is a different form.
 func FromEnvironment() *Config {
 	return &Config{
-		HTTPProxy:  getEnvAny("HTTP_PROXY", "http_proxy"),
-		HTTPSProxy: getEnvAny("HTTPS_PROXY", "https_proxy"),
-		NoProxy:    getEnvAny("NO_PROXY", "no_proxy"),
+		HTTPProxy:  getEnvAny("http_proxy", "HTTP_PROXY"),
+		HTTPSProxy: getEnvAny("https_proxy", "HTTPS_PROXY"),
+		NoProxy:    getEnvAny("no_proxy", "NO_PROXY"),
 		CGI:        os.Getenv("REQUEST_METHOD") != "",
 	}
 }
diff --git a/src/vendor/golang.org/x/net/quic/config.go b/src/vendor/golang.org/x/net/quic/config.go
index a9ec4bc437..d8bd7cba57 100644
--- a/src/vendor/golang.org/x/net/quic/config.go
+++ b/src/vendor/golang.org/x/net/quic/config.go
@@ -110,6 +110,9 @@ type Config struct {
 // Clone returns a shallow clone of c, or nil if c is nil.
 // It is safe to clone a [Config] that is being used concurrently by a QUIC endpoint.
 func (c *Config) Clone() *Config {
+	if c == nil {
+		return nil
+	}
 	n := *c
 	return &n
 }
diff --git a/src/vendor/golang.org/x/net/quic/endpoint.go b/src/vendor/golang.org/x/net/quic/endpoint.go
