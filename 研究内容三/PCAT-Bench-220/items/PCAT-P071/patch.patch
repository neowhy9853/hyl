+	if (!target_type || strcmp(target_type, "vdo"))
+		goto_out;
+	/* Reject multi-target devices */
+	if (dm_get_next_target(dmt, next, &start, &length,
+			       &target_type, &params))
+		goto_out;
+	r = 1;
+out:
+	dm_task_destroy(dmt);
+	return r;
