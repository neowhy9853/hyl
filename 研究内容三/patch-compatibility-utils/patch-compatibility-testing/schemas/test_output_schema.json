{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patch-compatibility-testing.skill/test-output-v1.json",
  "title": "Patch Compatibility Testing Result",
  "type": "object",
  "required": [
    "schema_version",
    "report_language",
    "analysis_json",
    "patch_id",
    "result_dir",
    "status",
    "target",
    "environment",
    "summary",
    "finding_results",
    "blocked_or_not_run",
    "artifacts",
    "conclusion"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "report_language": { "type": "string", "minLength": 2 },
    "analysis_json": { "type": "string", "minLength": 1 },
    "patch_id": { "type": "string", "minLength": 1 },
    "result_dir": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "partial", "blocked"]
    },
    "coverage_gate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 80
    },
    "target": {
      "type": "object",
      "required": ["repo", "base_commit", "analysis_repo", "package_profile"],
      "properties": {
        "repo": { "type": "string" },
        "base_commit": { "type": "string" },
        "analysis_repo": { "type": "string" },
        "package_profile": { "type": "string" }
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "required": [
        "kind",
        "before_build",
        "after_build",
        "compiler",
        "optimization",
        "coverage_tool",
        "notes"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["host", "container", "vm", "mixed", "not_available"]
        },
        "before_build": { "$ref": "#/$defs/executionStatus" },
        "after_build": { "$ref": "#/$defs/executionStatus" },
        "compiler": { "type": "string" },
        "optimization": { "type": "string" },
        "coverage_tool": { "type": "string" },
        "notes": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "findings_total",
        "findings_targeted",
        "entries_planned",
        "entries_generated",
        "entries_verified",
        "inputs_planned",
        "inputs_executed",
        "contracts_total",
        "contracts_passed",
        "contracts_breached",
        "contracts_skipped",
        "patch_executable_lines",
        "patch_lines_covered",
        "patch_lines_uncovered",
        "patch_line_coverage_rate"
      ],
      "properties": {
        "findings_total": { "$ref": "#/$defs/nonNegativeInteger" },
        "findings_targeted": { "$ref": "#/$defs/nonNegativeInteger" },
        "entries_planned": { "$ref": "#/$defs/nonNegativeInteger" },
        "entries_generated": { "$ref": "#/$defs/nonNegativeInteger" },
        "entries_verified": { "$ref": "#/$defs/nonNegativeInteger" },
        "inputs_planned": { "$ref": "#/$defs/nonNegativeInteger" },
        "inputs_executed": { "$ref": "#/$defs/nonNegativeInteger" },
        "contracts_total": { "$ref": "#/$defs/nonNegativeInteger" },
        "contracts_passed": { "$ref": "#/$defs/nonNegativeInteger" },
        "contracts_breached": { "$ref": "#/$defs/nonNegativeInteger" },
        "contracts_skipped": { "$ref": "#/$defs/nonNegativeInteger" },
        "patch_executable_lines": { "$ref": "#/$defs/nonNegativeInteger" },
        "patch_lines_covered": { "$ref": "#/$defs/nonNegativeInteger" },
        "patch_lines_uncovered": { "$ref": "#/$defs/nonNegativeInteger" },
        "patch_line_coverage_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "finding_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/findingResult" }
    },
    "blocked_or_not_run": {
      "type": "array",
      "items": { "$ref": "#/$defs/blocker" }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "impact_map",
        "test_entry_tasks",
        "test_entries",
        "test_inputs",
        "execution_results",
        "contract_summary",
        "coverage_data",
        "report"
      ],
      "additionalProperties": { "type": "string" }
    },
    "conclusion": {
      "type": "object",
      "required": [
        "backward_compatibility",
        "coverage_gate_met",
        "rationale",
        "recommended_actions"
      ],
      "properties": {
        "backward_compatibility": {
          "type": "string",
          "enum": ["compatible", "incompatible", "inconclusive"]
        },
        "coverage_gate_met": { "type": "boolean" },
        "rationale": { "type": "string" },
        "recommended_actions": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "stringArray": {
      "type": "array",
      "items": { "type": "string" }
    },
    "executionStatus": {
      "type": "string",
      "enum": ["passed", "failed", "not_run", "blocked"]
    },
    "findingStatus": {
      "type": "string",
      "enum": ["passed", "failed", "partial", "blocked", "not_run"]
    },
    "compatibilityType": {
      "type": "string",
      "enum": [
        "API_SIGNATURE_CHANGE",
        "ABI_CHANGE",
        "INPUT_CONTRACT_CHANGE",
        "RETURN_CONTRACT_CHANGE",
        "ERROR_EXCEPTION_CHANGE",
        "SIDE_EFFECT_CHANGE",
        "OUTPUT_FORMAT_CHANGE",
        "PROC_SYS_OUTPUT_CHANGE",
        "SYSCALL_SEMANTIC_CHANGE",
        "IOCTL_NETLINK_ABI_CHANGE",
        "CONFIG_CLI_BEHAVIOR_CHANGE",
        "RESOURCE_LIFETIME_CHANGE",
        "PERFORMANCE_RESOURCE_SEMANTIC_CHANGE"
      ]
    },
    "lineLocation": {
      "type": "object",
      "required": ["file", "new_lines", "symbol"],
      "properties": {
        "file": { "type": "string" },
        "new_lines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0 }
        },
        "symbol": { "type": "string" }
      },
      "additionalProperties": false
    },
    "entryResult": {
      "type": "object",
      "required": [
        "entry_id",
        "status",
        "artifact_path",
        "run_command",
        "expected_signal",
        "reachability_signal"
      ],
      "properties": {
        "entry_id": { "type": "string" },
        "status": { "type": "string" },
        "artifact_path": { "type": "string" },
        "run_command": { "type": "string" },
        "expected_signal": { "type": "string" },
        "reachability_signal": { "type": "string" }
      },
      "additionalProperties": true
    },
    "contractResult": {
      "type": "object",
      "required": ["contract_id", "status", "detail"],
      "properties": {
        "contract_id": { "type": "string" },
        "status": { "type": "string", "enum": ["passed", "breached", "skipped"] },
        "detail": { "type": "string" }
      },
      "additionalProperties": true
    },
    "coverageResult": {
      "type": "object",
      "required": ["executable_lines", "covered_lines", "uncovered_lines", "rate"],
      "properties": {
        "executable_lines": { "$ref": "#/$defs/nonNegativeInteger" },
        "covered_lines": { "$ref": "#/$defs/nonNegativeInteger" },
        "uncovered_lines": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rate": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": true
    },
    "behaviorDifference": {
      "type": "object",
      "required": ["input_id", "diff_type", "before", "after", "evidence"],
      "properties": {
        "input_id": { "type": "string" },
        "diff_type": { "$ref": "#/$defs/compatibilityType" },
        "before": { "type": "string" },
        "after": { "type": "string" },
        "evidence": { "type": "string" }
      },
      "additionalProperties": true
    },
    "findingResult": {
      "type": "object",
      "required": [
        "finding_id",
        "compatibility_type",
        "test_priority",
        "status",
        "target_location",
        "entries",
        "contracts",
        "coverage",
        "behavior_differences",
        "notes"
      ],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^(PCA|PCIA)-[0-9]{4}$" },
        "compatibility_type": { "$ref": "#/$defs/compatibilityType" },
        "test_priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "status": { "$ref": "#/$defs/findingStatus" },
        "target_location": { "$ref": "#/$defs/lineLocation" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/entryResult" }
        },
        "contracts": {
          "type": "array",
          "items": { "$ref": "#/$defs/contractResult" }
        },
        "coverage": { "$ref": "#/$defs/coverageResult" },
        "behavior_differences": {
          "type": "array",
          "items": { "$ref": "#/$defs/behaviorDifference" }
        },
        "notes": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": true
    },
    "blocker": {
      "type": "object",
      "required": ["scope", "id", "reason", "required_action"],
      "properties": {
        "scope": { "type": "string", "enum": ["environment", "build", "entry", "input", "contract", "coverage", "finding"] },
        "id": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 },
        "required_action": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
